# ====================================================================
# MediCore Environment Configuration Template
# Safe configuration template: DO NOT commit real secrets to Git.
# ====================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Security & Authentication
JWT_SECRET=medicore-change-me-to-a-64-character-random-hex-key-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# PostgreSQL System of Record
POSTGRES_DB=medicore
POSTGRES_USER=medicore_user
POSTGRES_PASSWORD=ChangeMeSecurePassword2026!
DATABASE_URL=postgresql://medicore_user:ChangeMeSecurePassword2026!@localhost:5432/medicore
USE_MEMORY_DB=false

# Redis Caching & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMeRedisPass2026!

# Microservice Integrations
ANALYTICS_SERVICE_URL=http://localhost:8000
FHIR_MOCK_URL=http://localhost:5000/api/v1/fhir

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000/api/v1/analytics
